# HangTime environment (no secrets in this file).
# Copy to .env.local for local overrides. Preview builds work without DATABASE_URL (PGLite).

# Postgres connection string. Required for persistent auth/Plus data in production.
# Leave unset on preview to use the in-memory PGLite fallback.
DATABASE_URL=

# Better Auth signing secret (32+ random bytes). Preview mints an ephemeral secret.
BETTER_AUTH_SECRET=

# Public origin of this deployment, e.g. https://hangtime.vercel.app
# Required for OAuth redirect_uri when auth is enabled.
BETTER_AUTH_URL=

# "true" enables real sign-in. "false" uses the local/dev user and must not be
# combined with DATABASE_URL (the app fail-closes).
VITE_AUTH_ENABLED=true

# Optional Grok auth-broker federation (only if you use that broker).
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Stripe Plus currently uses hardcoded test Payment Links in src/lib/plus/stripe.ts.
# No Stripe secret is required for the Payment Link checkout path.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
